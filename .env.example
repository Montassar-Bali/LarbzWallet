# Server-only CoinGecko Demo API key. Never prefix this with NEXT_PUBLIC_.
COINGECKO_API_KEY=

# Server-only Ondo Global Markets API key used by the Trust Markets Ondo tab.
ONDO_API_KEY=

# Optional server-only fallback for current Ethereum ONDO token pricing.
# The official Ondo feed above is preferred whenever both keys are configured.
BLOCKDAEMON_API_KEY=

# Optional compatible provider credentials.
CRYPTO_API_KEY=

# Optional compatible endpoint override.
CRYPTO_API_URL=https://api.freecryptoapi.com/v1/getData

# Server-only Neon PostgreSQL connection string for persistent access keys,
# audit/rate-limit data, shared wallet data, and wallet biometric/PIN security.
# Required in production; wallet security fails closed when it is missing.
DATABASE_URL=

# Optional local-development/test override for the file fallback used only when
# DATABASE_URL is absent. Production wallet security never uses this file.
WALLET_SECURITY_DATA_FILE=

# Dedicated server-only HMAC secret for privacy-preserving recovery-PIN rate-limit
# fingerprints. Use a random 32+ character value different from other secrets.
# LICENSE_KEY_PEPPER is a compatibility fallback only; production validation
# requires this dedicated value.
WALLET_SECURITY_RATE_LIMIT_SECRET=

# Dedicated server-only pepper for recovery-PIN hashes. Use another random 32+
# character value. LICENSE_KEY_PEPPER is a compatibility fallback only;
# production validation requires this dedicated value.
WALLET_SECURITY_PIN_PEPPER=

# Admin authentication. Prefer the 64-character SHA-256 hex digest of a long,
# randomly generated administrator key in production. ADMIN_ACCESS_KEY is a
# server-only fallback for local setup. Set only one; never use NEXT_PUBLIC_.
ADMIN_ACCESS_KEY_HASH=
ADMIN_ACCESS_KEY=

# Long, random server-only secret used to sign administrator sessions.
ADMIN_SESSION_SECRET=

# Long, random server-only pepper used when hashing license keys at rest.
LICENSE_KEY_PEPPER=
